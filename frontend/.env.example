# Copy to .env.local and fill with values from Supabase → Project Settings → API.
# Both are PUBLIC by design (they end up in the browser bundle); security comes from RLS.
# Leave empty to run the app in local-only mode (localStorage, no login).
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
